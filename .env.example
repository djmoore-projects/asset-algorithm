# Supabase
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Anthropic
ANTHROPIC_API_KEY=your_anthropic_api_key

# Resend (Email)
RESEND_API_KEY=your_resend_api_key
RESEND_FROM_EMAIL=deals@yourdomain.com

# Twilio (Voice + SMS)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# Stripe
STRIPE_SECRET_KEY=your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
CRON_SECRET=your_cron_secret

# PostHog Analytics
NEXT_PUBLIC_POSTHOG_KEY=your_posthog_project_api_key
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Apollo.io (company discovery + contact enrichment)
# Settings > Integrations > API. Free plan covers company search.
APOLLO_API_KEY=your_apollo_api_key

# Hunter.io (email discovery by domain)
HUNTER_API_KEY=your_hunter_api_key

# AI prompts
# The prompt bodies are loaded from configuration rather than committed, so this
# repo ships the interface without the prompt engineering. Supply your own to
# run the AI features. Any left unset fall back to a placeholder string.
AI_PROMPT_SYSTEM=
AI_PROMPT_SCANNER_ENRICHMENT=
AI_PROMPT_CONTACT_EXTRACTION=
AI_PROMPT_ENRICHED_EXTRACTION=
AI_PROMPT_LEAD_SCORING=
AI_PROMPT_DEAL_SCORING=
AI_PROMPT_DEAL_ANALYSIS=
AI_PROMPT_MEETING_PREP=
AI_PROMPT_EMAIL=
AI_PROMPT_CALL_SCRIPT=
AI_PROMPT_SMS=
AI_PROMPT_LINKEDIN=
AI_PROMPT_FINANCING=
AI_PROMPT_VALUATION=
AI_PROMPT_EXIT_STRATEGY=
AI_PROMPT_DILIGENCE=
AI_PROMPT_INTEGRATION=
AI_PROMPT_SCALING=

# Automated outbound calling stays off. See src/lib/integrations/twilio.ts.
# ENABLE_AUTOMATED_CALLS=false

